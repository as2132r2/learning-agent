# Day13部署配置示例。复制需要的项目到根目录.env，不要提交真实密钥。

DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_KEY=replace-with-your-real-key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 客户端访问受保护接口时使用的Bearer Token。
DAY13_API_KEY=replace-with-a-long-random-token

# 本机学习使用127.0.0.1；容器或局域网部署通常使用0.0.0.0。
HTTP_HOST=127.0.0.1
HTTP_PORT=8000
